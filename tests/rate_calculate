  <!-- 計算ロジック & UIバインディング JS -->
  <!-- ========================================================================= -->
  <script>
    /**
     * (1) ペア平均レートの算出
     * @param {number} r1 - 選手1の基準レート
     * @param {number} r2 - 選手2の基準レート
     * @returns {number} ペア平均レート
     */
    function calculatePairRating(r1, r2) {
      return (r1 + r2) / 2.0;
    }

    /**
     * (2) 勝率期待値 (E_A, E_B) の算出
     * 標準ロジスティック曲線: E_A = 1 / (1 + 10 ^ ((R_B - R_A) / 400))
     * @param {number} pairA - ペアAの平均レート
     * @param {number} pairB - ペアBの平均レート
     * @returns {{expA: number, expB: number}}
     */
    function calculateExpectedScore(pairA, pairB) {
      const diff = pairB - pairA;
      const expA = 1.0 / (1.0 + Math.pow(10.0, diff / 400.0));
      const expB = 1.0 - expA;
      return { expA, expB };
    }

    /**
     * (3)-a ゲーム差補正係数 G(ΔGames) の算出
     * G(ΔGames) = max(0.2, 1 + 0.1 * ΔGames)
     * @param {number} gameDiff - 獲得ゲーム数 - 喪失ゲーム数
     * @returns {number} 補正係数（下限0.2）
     */
    function calculateGameDiffMultiplier(gameDiff) {
      return Math.max(0.2, 1.0 + 0.1 * gameDiff);
    }

    /**
     * 四捨五入処理（絶対値が大きい方へ丸める標準的な四捨五入）
     * @param {number} val
     * @returns {number}
     */
    function roundHalfUp(val) {
      return val >= 0 ? Math.floor(val + 0.5) : Math.ceil(val - 0.5);
    }

    /**
     * (3)-b 試合単位のレート変動値 (ΔR) の算出
     * ΔR = round( 16 * (S - E) * G(ΔGames) )
     * @param {number} s - 勝敗 (勝利: 1, 敗北: 0)
     * @param {number} expected - 勝率期待値
     * @param {number} gameDiff - ゲーム差
     * @param {number} scale - 固定スケール (16pt)
     * @returns {{delta: number, g: number}}
     */
    function calculateMatchDelta(s, expected, gameDiff, scale = 16.0) {
      const g = calculateGameDiffMultiplier(gameDiff);
      const rawDelta = scale * (s - expected) * g;
      const delta = roundHalfUp(rawDelta);
      return { delta, g };
    }

    /**
     * (4) 最終レートのクリップ（Clamp）処理 [100, 999]
     * @param {number} rate
     * @param {number} minVal
     * @param {number} maxVal
     * @returns {number}
     */
    function clampRating(rate, minVal = 100, maxVal = 999) {
      return Math.max(minVal, Math.min(maxVal, rate));
    }


    /**
     * UIの入力値を取得し、計算および画面反映を実行
     */
    function calculateRating() {
      // 1. 各入力値の取得
      const pA1_name = document.getElementById('pA1_name').value || 'A1';
      const pA1_rate = parseFloat(document.getElementById('pA1_rate').value) || 500;
      const pA2_name = document.getElementById('pA2_name').value || 'A2';
      const pA2_rate = parseFloat(document.getElementById('pA2_rate').value) || 500;

      const pB1_name = document.getElementById('pB1_name').value || 'B1';
      const pB1_rate = parseFloat(document.getElementById('pB1_rate').value) || 500;
      const pB2_name = document.getElementById('pB2_name').value || 'B2';
      const pB2_rate = parseFloat(document.getElementById('pB2_rate').value) || 500;

      const gamesA = parseInt(document.getElementById('games_A').value) || 0;
      const gamesB = parseInt(document.getElementById('games_B').value) || 0;

      // 2. ペア平均レートの算出
      const pairA_avg = calculatePairRating(pA1_rate, pA2_rate);
      const pairB_avg = calculatePairRating(pB1_rate, pB2_rate);

      document.getElementById('pairA_avg_badge').innerText = pairA_avg.toFixed(1);
      document.getElementById('pairB_avg_badge').innerText = pairB_avg.toFixed(1);

      // 3. 勝率期待値の算出
      const { expA, expB } = calculateExpectedScore(pairA_avg, pairB_avg);
      document.getElementById('exp_A_text').innerText = (expA * 100).toFixed(1) + '%';
      document.getElementById('exp_B_text').innerText = (expB * 100).toFixed(1) + '%';
      document.getElementById('exp_bar_A').style.width = (expA * 100) + '%';
      document.getElementById('exp_bar_B').style.width = (expB * 100) + '%';

      // 4. 勝敗 (S) と ゲーム差 (ΔGames) の判定
      const sA = gamesA > gamesB ? 1.0 : 0.0;
      const sB = 1.0 - sA;
      const diffA = gamesA - gamesB;
      const diffB = gamesB - gamesA;

      // 5. 変動値 (ΔR) の算出
      const resA = calculateMatchDelta(sA, expA, diffA);
      const resB = calculateMatchDelta(sB, expB, diffB);

      // ゲーム差・補正係数の表示
      document.getElementById('g_diff_A_text').innerText = (diffA >= 0 ? '+' : '') + diffA;
      document.getElementById('g_diff_B_text').innerText = (diffB >= 0 ? '+' : '') + diffB;
      document.getElementById('g_mult_A_text').innerText = resA.g.toFixed(2) + 'x';
      document.getElementById('g_mult_B_text').innerText = resB.g.toFixed(2) + 'x';

      // 変動値の表示
      const deltaADisp = document.getElementById('delta_A_disp');
      const deltaBDisp = document.getElementById('delta_B_disp');
      deltaADisp.innerText = (resA.delta >= 0 ? '+' : '') + resA.delta;
      deltaBDisp.innerText = (resB.delta >= 0 ? '+' : '') + resB.delta;
      deltaADisp.className = `text-4xl font-extrabold font-mono tracking-tight ${resA.delta >= 0 ? 'text-emerald-400' : 'text-rose-400'}`;
      deltaBDisp.className = `text-4xl font-extrabold font-mono tracking-tight ${resB.delta >= 0 ? 'text-emerald-400' : 'text-rose-400'}`;

      // 計算式の数値プレビュー
      document.getElementById('formula_eA').innerText = expA.toFixed(2);
      document.getElementById('formula_gA').innerText = resA.g.toFixed(2);
      document.getElementById('formula_eB').innerText = expB.toFixed(2);
      document.getElementById('formula_gB').innerText = resB.g.toFixed(2);

      // 勝敗バッジの更新
      const badgeA = document.getElementById('result_badge_A');
      const badgeB = document.getElementById('result_badge_B');
      if (sA === 1.0) {
        badgeA.className = 'px-3 py-1 text-xs font-extrabold rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
        badgeA.innerText = 'WIN';
        badgeB.className = 'px-3 py-1 text-xs font-extrabold rounded-full bg-rose-500/20 text-rose-300 border border-rose-500/30';
        badgeB.innerText = 'LOSE';
      } else {
        badgeA.className = 'px-3 py-1 text-xs font-extrabold rounded-full bg-rose-500/20 text-rose-300 border border-rose-500/30';
        badgeA.innerText = 'LOSE';
        badgeB.className = 'px-3 py-1 text-xs font-extrabold rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
        badgeB.innerText = 'WIN';
      }

      // 6. 選手別の確定レート反映 (Clamp処理 [100, 999])
      const final_A1 = clampRating(pA1_rate + resA.delta);
      const final_A2 = clampRating(pA2_rate + resA.delta);
      const final_B1 = clampRating(pB1_rate + resB.delta);
      const final_B2 = clampRating(pB2_rate + resB.delta);

      document.getElementById('res_pA1_name').innerText = pA1_name;
      document.getElementById('res_pA2_name').innerText = pA2_name;
      document.getElementById('res_pB1_name').innerText = pB1_name;
      document.getElementById('res_pB2_name').innerText = pB2_name;

      document.getElementById('res_pA1_old').innerText = pA1_rate;
      document.getElementById('res_pA2_old').innerText = pA2_rate;
      document.getElementById('res_pB1_old').innerText = pB1_rate;
      document.getElementById('res_pB2_old').innerText = pB2_rate;

      document.getElementById('res_pA1_new').innerText = final_A1;
      document.getElementById('res_pA2_new').innerText = final_A2;
      document.getElementById('res_pB1_new').innerText = final_B1;
      document.getElementById('res_pB2_new').innerText = final_B2;

      document.getElementById('res_pA1_diff').innerText = (resA.delta >= 0 ? '+' : '') + resA.delta;
      document.getElementById('res_pA2_diff').innerText = (resA.delta >= 0 ? '+' : '') + resA.delta;
      document.getElementById('res_pB1_diff').innerText = (resB.delta >= 0 ? '+' : '') + resB.delta;
      document.getElementById('res_pB2_diff').innerText = (resB.delta >= 0 ? '+' : '') + resB.delta;
      
      document.getElementById('res_pA1_diff').className = `text-[11px] font-mono ${resA.delta >= 0 ? 'text-emerald-400' : 'text-rose-400'}`;
      document.getElementById('res_pA2_diff').className = `text-[11px] font-mono ${resA.delta >= 0 ? 'text-emerald-400' : 'text-rose-400'}`;
      document.getElementById('res_pB1_diff').className = `text-[11px] font-mono ${resB.delta >= 0 ? 'text-emerald-400' : 'text-rose-400'}`;
      document.getElementById('res_pB2_diff').className = `text-[11px] font-mono ${resB.delta >= 0 ? 'text-emerald-400' : 'text-rose-400'}`;
    }

    /**
     * プリセットデータの自動入力
     */
    function applyPreset(type) {
      if (type === 'equal_close') {
        // 同格の接戦
        setInputs('佐藤', 500, '田中', 500, 6, '高橋', 500, '伊藤', 500, 4);
      } else if (type === 'equal_crush') {
        // 同格の圧勝
        setInputs('佐藤', 500, '田中', 500, 6, '高橋', 500, '伊藤', 500, 0);
      } else if (type === 'giant_kill') {
        // ジャイアントキリング（レート差400ptへの圧勝）
        setInputs('挑戦者A', 300, '挑戦者B', 300, 6, '王者X', 700, '王者Y', 700, 0);
      } else if (type === 'favorite_win') {
        // 格上の順当勝ち
        setInputs('王者X', 700, '王者Y', 700, 6, '挑戦者A', 300, '挑戦者B', 300, 1);
      } else if (type === 'clamp_guard') {
        // 下限100のガード
        setInputs('ビギナー1', 105, 'ビギナー2', 100, 0, '上級者1', 700, '上級者2', 700, 6);
      }
      calculateRating();
    }

    function setInputs(nA1, rA1, nA2, rA2, gA, nB1, rB1, nB2, rB2, gB) {
      document.getElementById('pA1_name').value = nA1;
      document.getElementById('pA1_rate').value = rA1;
      document.getElementById('pA2_name').value = nA2;
      document.getElementById('pA2_rate').value = rA2;
      document.getElementById('games_A').value = gA;

      document.getElementById('pB1_name').value = nB1;
      document.getElementById('pB1_rate').value = rB1;
      document.getElementById('pB2_name').value = nB2;
      document.getElementById('pB2_rate').value = rB2;
      document.getElementById('games_B').value = gB;
    }

    // 全ての入力フォームに対して、入力変更時に自動再計算するイベントリスナーを登録
    document.querySelectorAll('input').forEach(input => {
      input.addEventListener('input', calculateRating);
    });

    // 初回レンダリング
    calculateRating();
  </script>
</body>
</html>